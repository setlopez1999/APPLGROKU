<?xml version="1.0" encoding="utf-8" ?>
<!--
  Una fila de la parrilla: el canal a la izquierda y sus celdas de programa a la derecha.
  Lo instancia el MarkupList de ChannelGrid (renderizado perezoso: solo las filas visibles).

  Las celdas llegan ya construidas por domain/usecase/EpgGrid.brs — ancho FIJO por celda, no
  proporcional a la duración (docs/DISENO.md §2.4).

  ⚠ NO VERIFICADO EN DISPOSITIVO.
-->
<component name="ChannelRowItem" extends="Group">

  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/common/ChannelRowItem.brs" />

  <children>
    <Rectangle id="rowFocus" width="1792" height="112" visible="false" />
    <Rectangle id="rowBg" translation="[3,3]" width="1786" height="106" />

    <Poster id="logo" translation="[24,26]" width="90" height="60" />
    <Label id="number" translation="[130,44]" font="font:SmallSystemFont" />
    <Label id="name" translation="[200,40]" width="320" font="font:MediumSystemFont" />

    <LayoutGroup id="cells" translation="[560,12]" layoutDirection="horiz" itemSpacings="[12]" />
  </children>

</component>
