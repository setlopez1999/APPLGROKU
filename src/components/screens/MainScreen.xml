<?xml version="1.0" encoding="utf-8" ?>
<!--
  Contenedor browse-first post-login (docs/DISENO.md §2.3): barra superior + contenido de la pestaña
  activa. La app arranca en "TV en directo".

  ⚠ NO VERIFICADO EN DISPOSITIVO.
-->
<component name="MainScreen" extends="Group">

  <interface>
    <field id="logout" type="boolean" alwaysNotify="true" />
    <!-- El nodo Video se presta desde MainScene y se pasa a LiveScreen -->
    <field id="videoNode" type="node" onChange="onVideoNodeChanged" />
    <!-- cn_id con el que abrir el reproductor a pantalla completa; lo consume MainScene -->
    <field id="fullscreenCnId" type="integer" alwaysNotify="true" />
    <!-- cn_id en el que quedó el zapping al volver -->
    <field id="resumeCnId" type="integer" value="0" onChange="onResume" />
    <!-- Sube cada vez que la revalidacion detecta un cambio REAL en el catalogo -->
    <field id="catalogVersion" type="integer" value="0" onChange="onCatalogVersion" />
    <!-- Motivo por el que un canal no se pudo reproducir; lo consume MainScene para el modal -->
    <field id="blockedReason" type="string" alwaysNotify="true" />
    <field id="catchupTarget" type="assocarray" alwaysNotify="true" />
    <field id="adultUnlocked" type="boolean" value="false" onChange="onAdultUnlocked" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/screens/MainScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/domain/usecase/Tabs.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/Json.brs" />
  <script type="text/brightscript" uri="pkg:/source/domain/usecase/Favorites.brs" />

  <children>
    <!-- Sin fondo propio: en "TV en directo" el fondo ES el vídeo, que dibuja MainScene por detrás.
         Una pantalla con fondo sólido aquí taparía el modo inmersivo. -->
    <LiveScreen id="live" />
    <TopNavBar id="navBar" />
    <MyListScreen id="myList" visible="false" />
    <SearchScreen id="search" visible="false" />
    <ProfileMenu id="profileMenu" visible="false" />
  </children>

</component>
