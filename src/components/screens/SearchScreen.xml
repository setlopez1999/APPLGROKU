<?xml version="1.0" encoding="utf-8" ?>
<!--
  Buscar canales por nombre o número.

  Mismo patrón que "Mi lista": el teclado en pantalla arriba y `ChannelGrid` debajo con los
  resultados. El filtrado lo hace domain/usecase/Search.brs, que está probado.
-->
<component name="SearchScreen" extends="Group">

  <interface>
    <!-- Catálogo completo sobre el que buscar -->
    <field id="channels" type="array" />
    <field id="epgWindow" type="assocarray" />
    <field id="chosenCnId" type="integer" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/Json.brs" />
  <script type="text/brightscript" uri="pkg:/source/domain/usecase/Search.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" />
    <Label id="titulo" translation="[64,60]" font="font:LargeBoldSystemFont" text="Buscar" />
    <Label id="pista" translation="[64,130]" width="1400" font="font:SmallSystemFont"
           text="Escribe el nombre o el número del canal. Pulsa ABAJO para ir a los resultados." />

    <Keyboard id="teclado" translation="[64,180]" />
    <Label id="resumen" translation="[64,560]" width="1400" font="font:MediumSystemFont" />

    <ChannelGrid id="grid" translation="[64,620]" />
  </children>

</component>
