{
  "name": "applg-roku",
  "version": "1.0.0",
  "private": true,
  "description": "TV-Visor — canal Roku (BrightScript/SceneGraph)",
  "scripts": {
    "build": "node scripts/make-shapes.js && node scripts/build-isp.js",
    "build:oneplay": "node scripts/make-shapes.js && node scripts/build-isp.js oneplay",
    "build:playcom": "node scripts/make-shapes.js && node scripts/build-isp.js playcom",
    "shapes": "node scripts/make-shapes.js",
    "package": "npm run build:oneplay && bsc --project bsconfig.json",
    "deploy": "roku-deploy",
    "lint": "bsc --project bsconfig.json --create-package false --copy-to-staging false",
    "audit": "node scripts/audit-streams.js",
    "test": "node scripts/test.js"
  },
  "devDependencies": {
    "@rokucommunity/brs": "^0.47.6",
    "brighterscript": "^0.73.5",
    "roku-deploy": "^3.18.4"
  }
}
